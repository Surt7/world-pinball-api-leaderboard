{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "api-route": {
        "ClusterId": "core-api-cluster",
        "Order": 100,
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "graphql-route": {
        "ClusterId": "core-api-cluster",
        "Match": {
          "Path": "/graphql"
        }
      },
      "hub-assistant-route": {
        "ClusterId": "hub-cluster",
        "TimeoutPolicy": "ai-assistant-policy",
        "Order": 1,
        "Match": {
          "Path": "/api/chat/assistant/{**catch-all}"
        }
      },
      "hub-chat-route": {
        "ClusterId": "hub-cluster",
        "Order": 2,
        "Match": {
          "Path": "/api/chat/{**catch-all}"
        }
      },
      "hub-posts-route": {
        "ClusterId": "hub-cluster",
        "Match": {
          "Path": "/api/posts/{**catch-all}"
        }
      },
      "hub-signalr-route": {
        "ClusterId": "hub-cluster",
        "Match": {
          "Path": "/hubs/chat/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "core-api-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5085"
          }
        }
      },
      "hub-cluster": {
        "Destinations": {
          "destination1": {
          "Address": "http://localhost:5000"
          }
        }
      }
    }
  }
}
