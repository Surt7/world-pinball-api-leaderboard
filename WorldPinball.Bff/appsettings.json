{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "api-route": {
        "ClusterId": "core-api-cluster",
        "Match": {
          "Path": "/api/v1/{**catch-all}"
        }
      },
      "graphql-route": {
        "ClusterId": "core-api-cluster",
        "Match": {
          "Path": "/graphql"
        }
      }
    },
    "Clusters": {
      "core-api-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7010"
          }
        }
      }
    }
  }
}
